{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "{lib/**,public/runtime/**,public/directory.json}"
    }
  },
  "headers": [
    {
      "source": "/(agent-manifest\\.json|agent_atlas\\.network\\.json|agent_atlas\\.hocon|links\\.json|agent-mcp\\.json)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/bridge/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}